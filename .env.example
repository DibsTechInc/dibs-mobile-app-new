# Copy to `.env` and fill in. See docs/environments.md for what each value is and
# where to get it. Nothing here is a server secret — EXPO_PUBLIC_* values are
# compiled into the app bundle by design. Never put a Stripe secret key or any
# API credential in this file.

# Which white-label studio to build/run as. Must match a directory name under
# whitelabel/studios/.
STUDIO_SLUG=carlsbad-village-yoga

# API base URL, including the /api/v2 suffix.
#   iOS simulator      http://localhost:3001/api/v2
#   Android emulator   http://10.0.2.2:3001/api/v2
#   physical device    http://<laptop-LAN-IP>:3001/api/v2
#   production         https://api.dibsonline.com/api/v2   (normally comes from studio.json)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v2

# Firebase client config — project `dibs-studio-clients` (the CLIENT project, NOT
# dibs-admin-users). Source of truth: dibs-widget-new/.env REACT_APP_FIREBASE_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=dibs-studio-clients.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dibs-studio-clients
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
