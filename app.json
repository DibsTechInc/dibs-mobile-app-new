{
  "expo": {
    "name": "flex-mobile",
    "description": "A booking app for Flex Studios.",
    "slug": "flex-mobile",
    "privacy": "public",
    "sdkVersion": "26.0.0",
    "platforms": ["ios"],
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#8ec549"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ondibs.flexstudioapp"
    }
  }
}
